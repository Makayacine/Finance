# LOCAL-ONLY values for docker-compose.yml and the test suite. Nothing here is a real credential.
#
# Copy to .env (gitignored) to change the SA password; docker compose reads .env from this folder,
# and the tests read MSSQL_SA_PASSWORD from the environment with the same default.
MSSQL_SA_PASSWORD=CreditMailer-Local-2003

# What the jobs read. Export these in the shell that runs them (the tests set them for you).
#
# SQL: server and login only. The jobs choose the database with --database (default
# db_credit_mailer). TrustServerCertificate=yes accepts the container's self-signed certificate;
# ODBC Driver 18 encrypts by default and refuses it otherwise.
AZURE_SQL_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=127.0.0.1,1433;UID=sa;PWD=CreditMailer-Local-2003;TrustServerCertificate=yes"

# Storage: the SDKs' shorthand for Azurite's published development account on 127.0.0.1.
AZURE_STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"
